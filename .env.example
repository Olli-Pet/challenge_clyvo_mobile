# Copie este arquivo para .env e preencha os valores.
# O .env fica fora do repositorio; este exemplo mostra as chaves necessarias.
#
# O prefixo EXPO_PUBLIC_ e obrigatorio: sem ele o Expo nao expoe a variavel
# ao aplicativo. Depois de editar o .env, reinicie com: npx expo start --clear

# Endereco da API da clinica (projeto Java).
# Deixe em branco para o app descobrir sozinho: localhost no navegador e o IP
# do computador de desenvolvimento no celular, via Expo.
EXPO_PUBLIC_API_URL=https://sua-api.onrender.com

# Firebase — valores em Configuracoes do projeto > Seus aplicativos > Web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
